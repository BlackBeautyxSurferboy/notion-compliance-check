# Notion internal integration token — create at https://www.notion.so/my-integrations
# Current format starts with "ntn_" (legacy tokens started with "secret_" — both work).
# The integration must be added to every page/database you want to audit
# (Open page → ... menu → Connections → Connect to "Notion Compliance Check").
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Page ID where compliance reports will be written as new sub-pages.
# Find it in the URL of any page (the 32-char hex string after the last "-").
NCC_REPORT_PARENT_PAGE_ID=

# Optional: shared secret the Notion Button webhook must include in the JSON body
# as { "secret": "..." } so unauthenticated webhooks cannot be triggered by strangers.
NCC_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Optional: ID of the audit-history database created by `ncc dashboard-setup`.
# When set, every `audit --post` (CLI or webhook) appends a row to this DB.
NCC_HISTORY_DB_ID=

# Stale-data threshold in days (default: 365)
NCC_STALE_THRESHOLD_DAYS=365

# Webhook server port (default: 8000)
NCC_WEBHOOK_PORT=8000
